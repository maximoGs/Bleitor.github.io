# Puerto del servidor
PORT=3000

# Proveedor de WhatsApp a usar: 'local' (whatsapp-web.js con QR) o 'api' (Twilio u otro)
WHATSAPP_PROVIDER=local

# Configuración para la opción autónoma (local)
# Para desplegar en entornos como Render/Railway con whatsapp-web.js,
# es posible que necesites especificar la ruta a Chromium si se instala por buildpack.
# CHROMIUM_PATH=/usr/bin/chromium-browser

# Configuración si usarás Twilio (WHATSAPP_PROVIDER=api)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# Configuración si usarás una API HTTP de terceros alternativa (como Zenziva, etc.)
# HTTP_API_URL=https://api.proveedor.com/send
# HTTP_API_TOKEN=tu_api_token_secreto

# Números de destino de los socios (por defecto ya están en el servidor, pero puedes cambiarlos aquí)
SOCIO_MAXIMO_PHONE=+5492614720776
SOCIO_PABLO_PHONE=+5492617094195
